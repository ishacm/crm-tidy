# Copy to .env and fill in. .env is git-ignored and never committed.
GROQ_API_KEY=                 # free, console.groq.com (used for ICP drafting and website classification)
APOLLO_API_KEY=               # optional, Settings > Integrations > API in Apollo (free plan works with a work email)
CLAY_WEBHOOK_URL=             # optional, a Clay table's "Import from webhook" URL (plan-dependent)
SLACK_WEBHOOK_URL=            # optional, posts briefs for top-tier records
CRMTIDY_ALLOW_PAID=false      # paid AI providers are refused unless "true"
CRMTIDY_API_TOKEN=                # set this if the API listens beyond localhost (e.g. for n8n in Docker)
